# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Tool and package caches
.cache/
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
.venvs/
env/
venv/

# Agent-generated documentation and outputs
codex_outputs/
AGENTS.md
**/AGENTS.md
WORKSPACE_FILE_MANIFEST.txt
architectures/*/results.md

# Generated runtime outputs
outputs/
wandb/
lightning_logs/
runs/
logs/
tmp/
temp/

# Data and heavy artifacts
data/
datasets/
LIBERO_DATASETS/
checkpoints/
ckpts/
*.pth
*.pt
*.ckpt
*.safetensors

# Upstream architecture clones kept as separate git repositories unless
# intentionally converted to git submodules.
architectures/simvla/upstream/
architectures/openpi/upstream/

# Experiment results stay local. Keep only the repository-level schema.
results/**
!results/README.md

# Keep these tracked if this workspace later commits them.
!architectures/**/env/
!architectures/**/env/README.md
!architectures/**/env/*.yml
!architectures/**/env/*.yaml
!architectures/**/env/*.txt
!configs/**
!scripts/**
!methods/**

# Re-apply generated Python cache ignores after broad source unignore rules.
**/__pycache__/
*.pyc
*.pyo
